#compdef kilo
#description:kilo AI coding agent CLI
#
# ZSH Completion for kilo (https://kilo.ai)
#
# Author: Emergency Self-Construct
# Assisted-by: Kilo (anthropic/claude-sonnet-5)
# Assisted-by: Kilo (moonshotai/kimi-k3)
# Licence: MIT (https://opensource.org/license/MIT)
# Version: 0.3 (unreleased)
# Homepage: https://github.com/esc/kilo-zsh-completion
#
# Hand-written against the CLI reference at:
#
#     https://kilo.ai/docs/code-with-ai/platforms/cli-reference
#
# Regenerate/diff against `kilo help --all --format md` whenever the CLI
# changes, since this completion does not parse kilo's own help output.
#
# To use this completion, install it somewhere on your hard drive:
#
#     $ git clone https://github.com/esc/kilo-zsh-completion
#
# And then add it to your $fpath in ~/.zshrc before you call compinit:
#
#     fpath+=/path/to/where/you/installed/kilo-zsh-completion
#     autoload -Uz compinit && compinit
#
# If you're using oh-my-zsh or Prezto, they will call compinit for you, so
# just add it to your $fpath before calling the OMZ or Prezto initialization
# functions.
#
# Dynamic completion
# -------------------
#
# Some values (models for --model, agents for --agent, session ids for
# --session/session delete/export/cloud *) are looked up by actually running
# `kilo` and caching the result, since kilo has no offline way to list them.
# The cache lives under:
#
#     ${XDG_CACHE_HOME:-$HOME/.cache}/kilo-completion/
#
# Sessions are listed with the most recently updated session first, one per
# line, as a table of fixed-width (40-char) titles with a shortened id on the
# right -- e.g. "Fix the thing                    ses_fcc9d3e..." -- while
# the value actually inserted is always the full, real session id.
#
# If $PWD is (or is inside) a directory that has sessions belonging to a
# real (non-"global") kilo project, session completion is scoped to just
# that project's sessions, mirroring how `kilo session list` (without
# --all) scopes to the current project. Sessions in kilo's "global" bucket
# (started outside any registered project) don't count for this: their
# directory field is just wherever kilo happened to run (possibly $HOME
# itself). Everywhere else, every session is listed, grouped by directory
# under a colored header, with menu-select enabled so the combined list is
# easy to navigate with the arrow keys. Menu-select is on by default for
# all of kilo's completions (not just sessions) unless you've already set
# your own `menu` style for kilo; override with:
#
#    zstyle ':completion::complete:kilo:*' menu <your-preference>
#
# Group header color: bold cyan by default. Override with any SGR spec or
# set to the empty string to disable, e.g.:
#
#    zstyle ':completion:*:*:kilo:*' session-group-color '34'
#    zstyle ':completion:*:*:kilo:*' session-group-color ''
#
# To tune the cache lifetime (in seconds, default 3600), add to '.zshrc':
#
#    zstyle ':completion:*:*:kilo:*' cache-ttl 3600
#
# To disable dynamic (kilo-invoking) completion entirely and only ever fall
# back to a plain message for those fields, add to '.zshrc':
#
#    zstyle ':completion:*:*:kilo:*' dynamic false
#
# To forcefully clean the completion cache:
#
#    $ rm -r ~/.cache/kilo-completion
#
# When developing, you can use the following to reload the completion after
# having modified it:
#
#    $ unfunction _kilo && autoload -Uz _kilo
#
# Please report any issues at:
# https://github.com/esc/kilo-zsh-completion/issues
#
# CHANGELOG
# ---------
#
# * v0.3 (unreleased)
#
#   * Fix bogus --agent completions: `kilo agent list` output format changed
#     (now prints a per-agent JSON config dump); parse only "name (mode)"
#     lines, and filter out kilo's internal utility agents (title, summary,
#     compaction -- recognizable by their deny-everything permission block,
#     since `agent list` doesn't expose their "hidden" flag). Raise the
#     cache regeneration timeout (5s -> 15s) since that command now takes
#     ~5s cold and was flakily killed.
#
# * v0.2
#
#   * Restore --all for session completion now that this has been fixed in
#     kilo (7.5.16).
#   * Session completion scopes to the current directory's own sessions when
#     they belong to a real (non-"global") project; otherwise every session
#     is listed, grouped by directory, with menu-select enabled by default
#     for kilo completions.
#   * Sessions are displayed one per line as an aligned table: the title
#     first (fixed 40-char column, longer titles truncated), then the
#     shortened session id; directory group headers are colored
#     (zstyle session-group-color). The value actually inserted is always the
#     full session id.
#   * Keep session listing in order of recency
#
# * v0.1
#
#   * Full coverage of the documented `kilo` CLI surface (subcommands,
#     flags, choice lists, nested subcommands).
#   * Cached dynamic completion for models, agents, and sessions.
#   * Session completions sorted by recency (most recently updated first).
#   * This self-documenting header.
#
# TODO
# ----
#
# * Dynamic completion for MCP server names (currently a plain message).
# * Consider a background/async cache refresh instead of a synchronous,
#   `timeout`-guarded call on cache miss.

# ---- cache helpers ----------------------------------------------------------

_kilo_cache_dir() {
  print -r -- "${XDG_CACHE_HOME:-$HOME/.cache}/kilo-completion"
}

_kilo_cache_ttl() {
  local ttl
  zstyle -s ':completion:*:*:kilo:*' cache-ttl ttl
  print -r -- "${ttl:-3600}"
}

_kilo_dynamic_enabled() {
  local dyn
  zstyle -s ':completion:*:*:kilo:*' dynamic dyn
  [[ -z $dyn || $dyn == true ]]
}

# _kilo_cached <cache-file-name> <command...>
# Prints cached output for <command...>, refreshing it synchronously
# (guarded by `timeout` when available) if the cache is missing or stale.
# Falls back to a stale cache on failure, and to nothing if there is none.
_kilo_cached() {
  local name=$1
  shift
  local dir="$(_kilo_cache_dir)"
  local file="$dir/$name"
  local ttl="$(_kilo_cache_ttl)"
  local fresh=0

  if [[ -f $file ]]; then
    (( $+builtins[zstat] )) || zmodload zsh/stat 2>/dev/null
    (( $+parameters[EPOCHSECONDS] )) || zmodload zsh/datetime 2>/dev/null
    local -a mtime
    local age=0
    if (( $+builtins[zstat] )); then
      zstat -A mtime +mtime -- "$file" 2>/dev/null
      age=$(( EPOCHSECONDS - ${mtime[1]:-0} ))
    fi
    (( age < ttl )) && fresh=1
  fi

  if (( ! fresh )) && _kilo_dynamic_enabled; then
    [[ -d $dir ]] || command mkdir -p -- "$dir" 2>/dev/null
    local out tmp="${file}.tmp.$$"
    # 15s guard: kilo cold-starts can take ~5s (e.g. `kilo agent list`
    # prints ~240KB of per-agent JSON config), so a tighter timeout here
    # would flakily kill the command and leave the cache unpopulated.
    if (( $+commands[timeout] )); then
      out="$(timeout 15 "$@" 2>/dev/null)"
    else
      out="$("$@" 2>/dev/null)"
    fi
    if [[ -n $out ]]; then
      print -r -- "$out" >| "$tmp" 2>/dev/null && command mv -f -- "$tmp" "$file" 2>/dev/null
    fi
  fi

  [[ -f $file ]] && cat -- "$file"
}

# ---- dynamic value sources ---------------------------------------------------

_kilo_model_list() {
  local raw
  raw="$(_kilo_cached models kilo models)"
  [[ -n $raw ]] || return 1
  print -r -- "$raw" | grep -oE '[A-Za-z0-9_.-]+/[A-Za-z0-9_.:-]+'
}

_kilo_models() {
  local -a models
  models=(${(f)"$(_kilo_model_list)"})
  if (( ${#models} )); then
    _describe -t kilo-models 'model (provider/model)' models
  else
    _message 'model (provider/model)'
  fi
}

_kilo_providers() {
  local -a models provider_raw providers
  models=(${(f)"$(_kilo_model_list)"})
  provider_raw=(${models%%/*})
  providers=(${(u)provider_raw})
  if (( ${#providers} )); then
    _describe -t kilo-providers 'provider' providers
  else
    _message 'provider id'
  fi
}

_kilo_agent_list() {
  local raw
  raw="$(_kilo_cached agents kilo agent list)"
  [[ -n $raw ]] || return 1
  # `kilo agent list` prints each agent as "<name> (<mode>)" followed by an
  # indented multi-line JSON dump of its configuration. Only take lines of
  # exactly that shape; anything else (JSON tokens, the closing "]" lines)
  # would otherwise be offered as bogus agent names.
  #
  # Additionally, kilo's internal utility agents (title/summary/compaction,
  # the ones `kilo debug agent` marks "hidden": true) are not valid choices
  # for --agent. `agent list` does not expose the hidden flag, but those
  # agents are recognizable: their entire permission dump is a single
  # deny-everything rule {"permission": "*", "action": "deny", "pattern":
  # "*"}. Filter those out.
  print -r -- "$raw" | awk '
    function flush() {
      if (name != "" && !(nrules == 1 && denyall)) print name
    }
    /^[[:alnum:]_.-]+ \((primary|subagent|all)\)/ {
      flush()
      name = $1
      nrules = 0
      denyall = 1
      next
    }
    /"permission"[[:space:]]*:/ {
      nrules++
      if ($0 !~ /"permission"[[:space:]]*:[[:space:]]*"\*"/) denyall = 0
    }
    /"action"[[:space:]]*:/ {
      if ($0 !~ /"action"[[:space:]]*:[[:space:]]*"deny"/) denyall = 0
    }
    /"pattern"[[:space:]]*:/ {
      if ($0 !~ /"pattern"[[:space:]]*:[[:space:]]*"\*"/) denyall = 0
    }
    END { flush() }
  '
}

_kilo_agents() {
  local -a agents
  agents=(${(f)"$(_kilo_agent_list)"})
  if (( ${#agents} )); then
    _describe -t kilo-agents 'agent' agents
  else
    _message 'agent name'
  fi
}

_kilo_session_pairs() {
  local raw
  # Note: `--all --format json` used to crash in kilo (7.4.23) with
  # "undefined is not an object (evaluating 'L.time.updated')"; fixed in
  # 7.5.16. --all is used deliberately so --session/session delete/export
  # can complete sessions across all projects, not just the current one.
  raw="$(_kilo_cached sessions kilo session list --all --format json)"
  [[ -n $raw ]] || return 1
  # Emit "id<TAB>directory<TAB>projectId<TAB>title" tuples, sorted by
  # most-recently-updated first. Session data returned by `kilo session list`
  # already appears to be pre-sorted this way, but we sort explicitly rather
  # than relying on that undocumented ordering. Tab-separated (rather than
  # colon-joined) so a colon in a title can't be mistaken for a field
  # separator. The projectId is needed to distinguish "global" sessions
  # (kilo's catch-all bucket for sessions started outside any registered
  # project) from sessions belonging to a real project.
  if (( $+commands[jq] )); then
    print -r -- "$raw" | jq -r \
      'sort_by(.updated // 0) | reverse | .[] | "\(.id)\t\(.directory // "")\t\(.projectId // "")\t\(.title // .id)"' 2>/dev/null
  else
    # No jq: extract "updated<TAB>id<TAB>directory<TAB>projectId<TAB>title"
    # per session (relies on kilo's pretty-printed JSON emitting
    # id/title/updated/projectId before directory within an object), sort
    # numerically by updated (descending), then drop the updated column.
    print -r -- "$raw" | awk -F'"' '
      /"id"[[:space:]]*:/        { id = $4 }
      /"title"[[:space:]]*:/     { title = $4 }
      /"updated"[[:space:]]*:/   { u = $0; gsub(/[^0-9]/, "", u) }
      /"projectId"[[:space:]]*:/ { pid = $4 }
      /"directory"[[:space:]]*:/ {
        dir = $4
        if (id != "") {
          printf "%s\t%s\t%s\t%s\t%s\n", u, id, dir, pid, (title != "" ? title : id)
        }
        id = ""; title = ""; dir = ""; pid = ""
      }
    ' | sort -t $'\t' -k1,1nr | cut -f2-
  fi
}

_kilo_sessions() {
  local -a ids dirs pids titles
  local id dir pid title
  while IFS=$'\t' read -r id dir pid title; do
    [[ -n $id ]] || continue
    ids+=("$id")
    dirs+=("$dir")
    pids+=("$pid")
    titles+=("$title")
  done < <(_kilo_session_pairs)
  if (( ! ${#ids} )); then
    _message 'session id'
    return
  fi

  # If $PWD is (or is inside) a directory that has sessions belonging to a
  # real (non-"global") project, scope the completion to just that
  # directory's sessions -- mirroring how `kilo session list` (without
  # --all) scopes to the current project. Sessions in kilo's "global" bucket
  # (started outside any registered project) are NOT a scoping candidate:
  # their directory field is just wherever kilo happened to run (e.g. $HOME
  # itself), so scoping on it would wrongly hide everything else when
  # completing from such a directory. Otherwise, fall back to browsing
  # every session, grouped by directory.
  local -a project_dirs
  local i
  for (( i = 1; i <= ${#ids}; i++ )); do
    [[ ${pids[i]} == global ]] && continue
    project_dirs+=("${dirs[i]}")
  done
  project_dirs=(${(u)project_dirs:#})
  local d here_dir=
  for d in $project_dirs; do
    [[ -n $d ]] || continue
    if [[ $PWD == $d || $PWD == $d/* ]]; then
      (( ${#d} > ${#here_dir} )) && here_dir=$d
    fi
  done

  # Emit one compadd group per directory. Everything below is deliberately
  # kept inline in this function: when this code lived in a helper function
  # (receiving the data via ${(@P)} indirection), the interactive listing
  # was corrupted by a spurious "i=N" string (N = a loop counter) being
  # drawn into the command line. The same constructs inline do not leak.
  local -a emit_dirs
  if [[ -n $here_dir ]]; then
    emit_dirs=("$here_dir")
  else
    emit_dirs=(${(u)dirs:#})
  fi

  # Group header color: bold cyan by default. Override with an SGR spec:
  #   zstyle ':completion:*:*:kilo:*' session-group-color '34'
  # Set to the empty string to disable coloring. Note: zstyle -s clobbers
  # the variable even when the style is unset, hence the || fallback.
  local color cstart='' cend=''
  zstyle -s ':completion:*:*:kilo:*' session-group-color color || color='01;36'
  if [[ -n $color ]]; then
    cstart=$'\e['"${color}"$'m'
    cend=$'\e[0m'
  fi

  local t short tag
  local -a gids gdisplays
  for d in $emit_dirs; do
    [[ -n $d ]] || continue
    gids=(); gdisplays=()
    for (( i = 1; i <= ${#ids}; i++ )); do
      [[ ${dirs[i]} == $d ]] || continue
      gids+=("${ids[i]}")
      t="${titles[i]:-${ids[i]}}"
      # Fixed-width title column (40 chars) so the id column lines up
      # uniformly across directory groups, not just within one group.
      (( ${#t} > 40 )) && t="${t[1,37]}..."
      short="${ids[i]#ses_}"
      short="${short[1,7]}"
      gdisplays+=("${(r:40:)t}  ses_${short}...")
    done
    (( ${#gids} )) || continue
    tag="kilo-sessions-${d//[^A-Za-z0-9]/-}"
    # -o nosort keeps the recency order from _kilo_session_pairs; without it
    # the listing gets sorted by display string (and menu-select would
    # auto-insert the alphabetically-first instead of the most recent one).
    compadd -l -o nosort -J "$tag" -V "$tag" -X "${cstart}${d}${cend}" -d gdisplays -a gids
  done
}

# ---- top-level command list --------------------------------------------------

_kilo_commands() {
  local -a commands
  commands=(
    'acp:start ACP (Agent Client Protocol) server'
    'mcp:manage MCP (Model Context Protocol) servers'
    'attach:attach to a running kilo server'
    'run:run kilo with a message'
    'debug:debugging and troubleshooting tools'
    'auth:manage AI providers and credentials'
    'agent:manage agents'
    'upgrade:upgrade kilo to the latest or a specific version'
    'uninstall:uninstall kilo and remove all related files'
    'serve:start a headless kilo server'
    'models:list all available models'
    'roll-call:batch-test text models matching a filter'
    'profile:show Kilo account profile'
    'stats:show token usage and cost statistics'
    'export:export session data as JSON'
    'import:import session data from JSON file or URL'
    'github:manage GitHub agent'
    'pr:manage pull requests'
    'session:manage sessions'
    'remote:enable remote connection for real-time session relay'
    'daemon:manage the local kilo daemon'
    'console:open or stop the local Kilo Console (deprecated)'
    'cloud:run Cloud Agent tasks'
    'db:database tools'
    'config:configuration tools'
    'plugin:install plugin and update config'
    'help:show full CLI reference'
    'completion:generate shell completion script'
  )
  _describe -t kilo-commands 'kilo command' commands
}

